{
  "name": "create-product-app",
  "private": true,
  "version": "1.0.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:vite && npm run build:verify",
    "lint": "eslint .",
    "preview": "vite preview",
    "schema:contract": "python3 scripts/build_database_contract.py && python3 scripts/generate_step2_sql.py",
    "schema:baseline": "bash scripts/step2_capture_production_baseline.sh",
    "schema:status": "bash scripts/step2_migration_status.sh",
    "schema:dry-run": "bash scripts/step2_db_push_dry_run.sh",
    "schema:types": "bash scripts/step2_generate_types.sh",
    "security:test": "node scripts/validate_steps3_5.mjs",
    "test:static": "node --test scripts/tests/static-contract.test.mjs",
    "test:security": "node --test scripts/tests/security-helpers.test.mjs",
    "test:calendar": "node --test scripts/tests/google-calendar.test.mjs",
    "test:mockups": "node --test scripts/tests/mockup-studio.test.mjs",
    "test:supplier-receiving": "node --test scripts/tests/supplier-confirmation-parser.test.mjs",
    "test:production-board": "node --test scripts/tests/production-board-active-lines.test.mjs",
    "test:imports": "node --test scripts/tests/spreadsheet-import-safety.test.mjs",
    "test:integrity": "node --test scripts/tests/application-integrity.test.mjs",
    "test:r2-egress": "node --test scripts/tests/r2-egress-completion.test.mjs",
    "migrate:r2-assets": "node scripts/migrate-operational-assets-to-r2.mjs",
    "test": "npm run test:static && npm run test:security && npm run test:calendar && npm run test:mockups && npm run test:supplier-receiving && npm run test:production-board && npm run test:imports && npm run test:integrity && npm run test:r2-egress",
    "functions:esm": "node scripts/validate_netlify_esm.mjs",
    "validate:steps6-14": "node scripts/validate_steps6_14.mjs",
    "check": "npm run functions:esm && npm run test && npm run lint && npm run build",
    "build:vite": "node scripts/build_vite.mjs",
    "build:verify": "node scripts/verify_build_features.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.883.0",
    "@aws-sdk/s3-request-presigner": "^3.883.0",
    "@supabase/supabase-js": "^2.106.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.2",
    "read-excel-file": "^9.3.10",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.2.2"
  }
}
