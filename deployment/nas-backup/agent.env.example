# Template only. Mode 0600, owned by root/backup account as appropriate.
# Never commit filled-in credentials. Use one config and destination per bucket.
SC_NAS_SITE=business
SC_R2_REMOTE=r2:REPLACE_WITH_VERIFIED_BUCKET
SC_NAS_MOUNT=/mnt/skilledcrafting-business
SC_NAS_EXPECTED_SOURCE=REPLACE_WITH_EXACT_MOUNTINFO_SOURCE
SC_NAS_DEST=/mnt/skilledcrafting-business/SkilledCrafting/R2-Backups/REPLACE_WITH_BUCKET
SC_RCLONE_CONFIG=/etc/skilledcrafting/nas-backup/rclone-read-only.conf
SC_NAS_STATE_DIR=/var/lib/sc-nas-backup/business
SC_APP_URL=https://inventory.skilledcrafting.com
SC_NAS_REPORT_TOKEN=REPLACE_PRIVATELY
SC_NAS_BWLIMIT=10M
SC_NAS_TRANSFERS=2
SC_NAS_MIN_FREE_BYTES=10737418240
